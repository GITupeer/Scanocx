# Laravel Cloud / produkcja — kluczowe zmienne

APP_NAME=Scanocx
APP_ENV=production
APP_KEY=
APP_URL=https://YOUR_APP.laravel.cloud
FRONTEND_URL=scanocx://reset-password

DB_CONNECTION=pgsql
# (Laravel Cloud ustawia DB_* automatycznie)

QUEUE_CONNECTION=redis
CACHE_STORE=redis
# (Laravel Cloud ustawia REDIS_*)

MAIL_MAILER=smtp
# skonfiguruj mail na Laravel Cloud (reset hasła)

GEMINI_API_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Po deployu:
# php artisan migrate --seed
# Horizon: włącz workery z config/horizon.php (supervisor-ai, max 3)
