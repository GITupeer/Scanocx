# Laravel Cloud / produkcja — kluczowe zmienne

APP_NAME=Scanocx
APP_ENV=production
APP_KEY=
APP_URL=https://YOUR_APP.laravel.cloud
FRONTEND_URL=scanocx://reset-password

DB_CONNECTION=pgsql
# (Laravel Cloud ustawia DB_* automatycznie)

QUEUE_CONNECTION=cloud
CACHE_STORE=redis
# (Laravel Cloud ustawia REDIS_* / managed queue credentials)

MAIL_MAILER=smtp
# skonfiguruj mail na Laravel Cloud (reset hasła)

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROVIDER=gemini
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Po deployu:
# php artisan migrate --seed
# Managed queue na Laravel Cloud: nazwa "ai", max 3 workers
# W env Cloud MUSI być: QUEUE_CONNECTION=cloud
